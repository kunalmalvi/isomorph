# Copy to .env and edit. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=isomorph
POSTGRES_PASSWORD=change-me
POSTGRES_DB=isomorph
# Outside Docker: postgresql+psycopg://isomorph:change-me@localhost:5432/isomorph
# DATABASE_URL=
# Set to false when PostgreSQL has no pgvector extension.
USE_PGVECTOR=true

# --- Backend ---
ISOMORPH_ENV=development
# At least 32 characters. Required to be set explicitly when ISOMORPH_ENV=production.
ISOMORPH_SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:3000
# ACCESS_TOKEN_TTL_SECONDS=3600
# MAX_UPLOAD_BYTES=5242880
# WORKER_THREADS=2

# --- AI provider (local needs no key and no network) ---
# One of: local, openai, gemini, anthropic
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_TIMEOUT_SECONDS=30
# AI_MAX_RETRIES=2
# AI_REQUESTS_PER_MINUTE=30

# --- Frontend (baked in at build time, must be reachable from the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Comma separated IPs or CIDR networks of reverse proxies whose X-Forwarded-For header is trusted for rate limiting.
# Empty (default) means the header is ignored.
TRUSTED_PROXIES=
# Directory for hypothesis decisions and notes. Empty keeps them in memory only (lost on restart).
# docker-compose defaults it to /var/lib/isomorph on a named volume.
ISOMORPH_STATE_DIR=
# Fail queued/running runs left by a dead process at startup. Set false with more than one API process.
RECOVER_INTERRUPTED_RUNS=true
# Maximum length of one SSE connection in seconds. The client reconnects automatically.
SSE_MAX_SECONDS=15
